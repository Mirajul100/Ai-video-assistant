MISTRAL_API_KEY=
WHISPER_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL1=
GEMINI_MODEL2=
# Optional Q&A fallback model; defaults to GEMINI_MODEL2 or gemini-3.5-flash-lite.
GEMINI_CHAT_FALLBACK_MODEL=
MISTRAL_MODEL=
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
SQLITE_PATH=
YTDLP_JS_RUNTIME=
YTDLP_JS_RUNTIME_PATH=
YOUTUBE_COOKIES=
# Supported: brave, chrome, chromium, edge, firefox, opera, safari, vivaldi, whale.
YOUTUBE_COOKIES_FROM_BROWSER=
# Optional YouTube client override. Authenticated downloads default to
# yt-dlp's default and web_embedded clients.
YOUTUBE_PLAYER_CLIENT=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Maximum simultaneous video/document processing jobs per worker; keep at 1 on small instances.
LUMEN_MAX_PROCESSING_JOBS=1
# Keep retries bounded so transient failures do not repeat expensive requests.
GEMINI_MAX_RETRIES=2
# Limit generated output tokens for predictable usage.
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_CHAT_MAX_OUTPUT_TOKENS=1536
